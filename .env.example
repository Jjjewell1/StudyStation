# StudyStation environment
# Copy to .env, fill in real values, NEVER commit .env

# --- Postgres (used by docker-compose to provision the db service) ---
POSTGRES_USER=studystation
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=studystation

# --- Canvas ---
# Your school's Canvas root URL, e.g. https://yourschool.instructure.com
CANVAS_BASE_URL=

# Preferred for Coolify: paste the ENTIRE contents of canvas_session.json as a
# single minified line ({"cookies":[...],"origins":[...]}).
# Leave empty on your dev PC to fall back to CANVAS_SESSION_FILE below.
CANVAS_SESSION_JSON=

# Dev-PC alternative: path to the session file produced by capture_session.py.
CANVAS_SESSION_FILE=./canvas_session.json

# --- Sync scheduling ---
# Cron expression for supercronic inside the sync container.
# NOTE: supercronic runs in UTC. 03:00 UTC = 22:00 Central (CDT).
SYNC_SCHEDULE=0 3 * * *
# RUN_ONCE=1 makes the container run one sync immediately and exit
# (useful for testing / manual re-syncs). Keep 0 for nightly cron mode.
RUN_ONCE=0

# --- Calendar pull window (days relative to the sync run date) ---
CAL_WINDOW_DAYS_BACK=120
CAL_WINDOW_DAYS_AHEAD=240

LOG_LEVEL=INFO
